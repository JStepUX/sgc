{
  "name": "sgc",
  "version": "1.10.0",
  "private": true,
  "type": "module",
  "description": "Salience-Gated Cognition — a tiered-memory conversational architecture prototype.",
  "main": "dist/electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n client,server -c cyan,green \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=dist/electron --out-extension:.js=.cjs",
    "start": "node dist/server/index.js",
    "electron:dev": "concurrently -k -n vite,server,electron \"npm:dev:client\" \"npm:dev:server\" \"npm:electron:dev:run\"",
    "electron:dev:run": "wait-on http://localhost:5555 && npm run build:electron && electron dist/electron/main.cjs",
    "electron:build": "npm run build && npm run build:electron",
    "dist:win": "npm run electron:build && node scripts/dist-win.mjs",
    "dist:mac": "npm run electron:build && node scripts/dist-mac.mjs",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "seed:dev": "node scripts/seed-dev-brains.mjs",
    "rebuild:node": "npm rebuild better-sqlite3",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint src electron"
  },
  "build": {
    "appId": "com.boltontechnology.sgc",
    "productName": "Salience-Gated Cognition",
    "artifactName": "sgc-v${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/electron/**",
      "dist/server/**",
      "dist/client/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/stock-brains",
        "to": "stock-brains",
        "filter": [
          "*.json"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/sal_logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "resources/icon.icns",
      "category": "public.app-category.developer-tools",
      "identity": null
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "jsdom": "^29.1.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^4.7.0",
    "chrono-node": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.4",
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "lucide-react": "^1.42.0",
    "mermaid": "^11.17.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "stemmer": "2.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^2.1.9",
    "wait-on": "^9.1.0"
  },
  "volta": {
    "node": "22.23.1"
  }
}
